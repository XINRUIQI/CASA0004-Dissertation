%% Figure 3.1 - Research design (Section 3.1).
%% Mermaid mirror of fig_3_1_research_design.png. Renders in Typora, Obsidian,
%% GitHub, VS Code and mermaid.live. Keep in sync with the matplotlib version
%% in 04_code/scripts/figures/make_design_figure.py.
%%{init: {"flowchart": {"wrappingWidth": 420, "curve": "basis", "nodeSpacing": 45, "rankSpacing": 55}} }%%
flowchart TD
    classDef src fill:#FFFFFF,stroke-width:1.5px,color:#22303C
    classDef set fill:#FFFFFF,stroke:#8A8A8A,color:#22303C
    classDef fam fill:#FFFFFF,stroke-width:1.5px,color:#22303C
    classDef ev  fill:#F4F2EE,stroke:#4A4A4A,color:#22303C
    classDef rq  fill:#FFFFFF,stroke:#7A6A55,color:#22303C
    classDef bm  fill:#FFFFFF,stroke:#4A4A4A,stroke-dasharray:5 3,color:#22303C

    FIN["<b>Financial time series</b><br/>Brent spot and futures,<br/>macro and oil-market series"]
    RSD["<b>Remote sensing</b><br/>Sentinel-2 patches, optical indices,<br/>night-time lights - 11 AOIs"]
    SHP["<b>Shipping</b><br/>AIS port calls and vessel traffic<br/>17-node graph - 6 chokepoints"]
    class FIN,RSD,SHP src
    style FIN stroke:#2E5A88
    style RSD stroke:#2E7D5B
    style SHP stroke:#D1622B

    M0["<b>M0</b> - no-change benchmark<br/>forecast P(t+1) = P(t)<br/><i>no predictors, not estimated</i>"]
    class M0 bm

    subgraph SETS["Information sets"]
        direction LR
        S1["<b>S1</b><br/>finance only"]
        S2["<b>S2</b><br/>S1 + remote sensing"]
        S3["<b>S3</b><br/>S1 + shipping"]
        S4["<b>S4</b><br/>S1 + remote sensing + shipping"]
    end
    class S1,S2,S3,S4 set
    style SETS fill:#F4F2EE,stroke:#D6D1C8,color:#5C5C5C

    %% Sources feed the band as a whole; each set's own label states its
    %% composition. Wiring every source to every set makes the graph unreadable.
    FIN --> SETS
    RSD --> SETS
    SHP --> SETS
    S1 -.->|"+ remote sensing"| S2
    S1 -.->|"+ shipping"| S3
    S1 -.->|"+ both"| S4

    FLAT["<b>Flat family</b> - early feature fusion<br/>all predictors stacked into one weekly table<br/>(4-week lookback)<br/>learners: Ridge, XGBoost<br/><i>RS input: site optical indices + night-time lights</i>"]
    DEEP["<b>Deep family</b> - representation-level fusion<br/>separate encoders: finance, remote sensing, shipping graph<br/>fusion: concatenation, gated (main), cross-attention<br/><i>RS input: learned Sentinel-2 patch embeddings</i>"]
    class FLAT,DEEP fam
    style FLAT stroke:#2E5A88
    style DEEP stroke:#D1622B

    %% Flat and Deep are deliberately left unconnected so the renderer keeps
    %% them side by side; the pairing is stated on their edges into EVAL.
    SETS --> FLAT
    SETS --> DEEP

    EVAL["<b>Shared expanding-window evaluation</b><br/>365 Friday weeks (4 Jan 2019 - 26 Dec 2025) - 104-week warm-up - refit every 13 weeks<br/>257 forecast origins (22 Jan 2021 - 19 Dec 2025) - one week ahead - no look-ahead<br/>RMSE, MAE, skill vs M0, Diebold-Mariano and Clark-West tests"]
    class EVAL ev

    FLAT -->|"paired comparison,<br/>same information set"| EVAL
    DEEP --> EVAL
    M0 -.->|"reference forecast"| EVAL

    RQ1["<b>RQ1</b><br/>Do remote sensing and shipping<br/>add forecast value?<br/>S1-S4 within each family;<br/>every model against M0"]
    RQ2["<b>RQ2</b><br/>Does representation-level modelling<br/>beat one flat table?<br/>paired Flat vs Deep;<br/>fusion variants inside Deep"]
    RQ3["<b>RQ3</b><br/>What does the model rely on?<br/>modality gates and node attention,<br/>restricted to Deep models<br/>that improve on M0"]
    class RQ1,RQ2,RQ3 rq

    EVAL --> RQ1
    EVAL --> RQ2
    EVAL --> RQ3
