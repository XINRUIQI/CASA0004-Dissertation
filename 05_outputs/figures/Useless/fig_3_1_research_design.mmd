%% Figure 3.1 - Research design (Section 3.1).
%% Mermaid mirror of fig_3_1_research_design.png. Keep in sync with
%% 04_code/scripts/figures/make_design_figure.py.
%%{init: {"flowchart": {"wrappingWidth": 280, "curve": "linear", "nodeSpacing": 28, "rankSpacing": 36}} }%%
flowchart TD
    classDef fin fill:#D4E4F2,stroke:#2E5A88,color:#22303C,stroke-width:1.4px
    classDef rs  fill:#D0EBDA,stroke:#2E7D5B,color:#22303C,stroke-width:1.4px
    classDef shp fill:#F5D8C8,stroke:#D1622B,color:#22303C,stroke-width:1.4px
    classDef set fill:#FFFFFF,stroke:#3F3F3F,color:#22303C
    classDef band fill:#EEF3F7,stroke:#3F3F3F,color:#22303C
    classDef flat fill:#D4E4F2,stroke:#2E5A88,color:#22303C,stroke-width:1.4px
    classDef deep fill:#F5D8C8,stroke:#D1622B,color:#22303C,stroke-width:1.4px
    classDef ev  fill:#F3E4C8,stroke:#6A5A3A,color:#22303C
    classDef rq  fill:#EDE0D6,stroke:#7A6A55,color:#22303C
    classDef bm  fill:#F4F2EE,stroke:#6A5A3A,stroke-dasharray:5 3,color:#22303C

    FIN["<b>Financial time series</b><br/>Brent spot and futures,<br/>macro and oil-market series"]
    RSD["<b>Remote sensing</b><br/>Sentinel-2 patches, optical indices,<br/>night-time lights · 11 AOIs"]
    SHP["<b>Shipping</b><br/>AIS port calls and vessel traffic<br/>17-node graph · 6 chokepoints"]
    class FIN fin
    class RSD rs
    class SHP shp

    INFO["<b>Information sets</b><br/>S2, S3 and S4 extend S1 in parallel · S4 combines both additions"]
    class INFO band

    S1["<b>S1</b><br/>finance only"]
    S2["<b>S2</b><br/>+ remote sensing"]
    S3["<b>S3</b><br/>+ shipping"]
    S4["<b>S4</b><br/>+ both"]
    class S1,S2,S3,S4 set

    FLAT["<b>Flat family</b><br/>early feature fusion<br/>predictors stacked into one weekly table<br/>(4-week lookback) · Ridge · XGBoost<br/><i>RS: site optical indices + night-time lights</i>"]
    DEEP["<b>Deep family</b><br/>representation-level fusion<br/>separate encoders: finance · RS · shipping<br/>fusion: concatenation · gated (main) · cross-attention<br/><i>RS: learned Sentinel-2 patch embeddings</i>"]
    class FLAT flat
    class DEEP deep

    M0["<b>M0</b> — no-change benchmark<br/>forecast P(t+1) = P(t)<br/><i>no predictors, not estimated</i>"]
    class M0 bm

    EVAL["<b>Shared expanding-window evaluation</b><br/>365 Friday weeks (Jan 2019 – Dec 2025) · 104-week warm-up · refit every 13 weeks<br/>257 forecast origins · one week ahead · no look-ahead<br/>RMSE · MAE · skill vs M0 · Diebold–Mariano and Clark–West tests"]
    class EVAL ev

    RQ1["<b>RQ1</b><br/>Do remote sensing and shipping<br/>add forecast value?<br/>S1–S4 within each family;<br/>every model against M0"]
    RQ2["<b>RQ2</b><br/>Does representation-level modelling<br/>beat one flat table?<br/>paired Flat vs Deep;<br/>fusion variants inside Deep"]
    RQ3["<b>RQ3</b><br/>What does the model rely on?<br/>modality gates and node attention,<br/>restricted to Deep models<br/>that improve on M0"]
    class RQ1,RQ2,RQ3 rq

    FIN --> INFO
    RSD --> INFO
    SHP --> INFO
    INFO --> S1
    INFO --> S2
    INFO --> S3
    INFO --> S4
    S1 --> FLAT
    S2 --> FLAT
    S3 --> FLAT
    S4 --> FLAT
    S1 --> DEEP
    S2 --> DEEP
    S3 --> DEEP
    S4 --> DEEP
    FLAT <-->|"paired comparison,<br/>same information set"| DEEP
    FLAT --> EVAL
    DEEP --> EVAL
    M0 -.-> EVAL
    EVAL --> RQ1
    EVAL --> RQ2
    EVAL --> RQ3
