# Local-only archive (literature PDFs, etc.) — never commit
_local/

# Raw downloads. Scripts, AOI tables and manifests are tracked (see exceptions).
data/raw/**
!data/raw/**/
!data/raw/**/*.py
!data/raw/**/*.js
!data/raw/**/*.md
!data/raw/**/aoi_oil_infrastructure.csv
!data/raw/**/s2_patch_exclusions.csv
!data/raw/**/manifest.csv
!data/raw/**/.gitkeep

# Secrets
.env
**/.gfw_token
**/*token*

# Large / generated binaries
*.zip
*.tar.gz
*.h5
*.pkl
*.parquet
*.psd

# Office / OS
~$*
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Thesis (Bookdown) — local only; not part of the public code/data repo
thesis/
